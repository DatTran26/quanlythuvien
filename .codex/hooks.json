{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/ba-kit-run.mjs sessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/ba-kit-run.mjs afterFileEdit",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
